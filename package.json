{
  "name": "car-dealership",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @cd/api\" \"npm run dev -w @cd/web\"",
    "build": "npm run build -w @cd/shared && npm run build -w @cd/api && npm run build -w @cd/web",
    "test": "npm run test -w @cd/api && npm run test -w @cd/web",
    "test:e2e": "npm run e2e -w @cd/web",
    "dev:db": "node scripts/dev-db.mjs",
    "start": "npm run start -w @cd/api",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:minimal": "tsx prisma/seed.ts --minimal",
    "admin:create": "tsx apps/api/src/scripts/create-admin.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0"
  }
}
