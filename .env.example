# Database (create DB "cardealer" first; see docs/SETUP.md)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/cardealer?schema=public"
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/cardealer_test?schema=public"

# API
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_ACCESS_SECRET=change-me-long-random-string-1
JWT_REFRESH_SECRET=change-me-long-random-string-2
COOKIE_SECURE=false

# Cloudinary (optional; falls back to local ./uploads in development)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optional; logs to console if SMTP_HOST empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Dealership <no-reply@example.com>"

# Google Maps (optional, used by web)
VITE_GOOGLE_MAPS_API_KEY=
