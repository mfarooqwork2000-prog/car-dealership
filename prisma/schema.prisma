generator client {
  provider = "prisma-client-js"
}

datasource db {
  url      = env("DATABASE_URL")
  provider = "postgresql"
}

// ───────────── Enums ─────────────
enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VehicleStatus {
  AVAILABLE
  PENDING
  SOLD
  ARCHIVED
}

enum VehicleCondition {
  NEW
  USED
  CERTIFIED
}

enum LeadType {
  GENERAL
  VEHICLE
  TEST_DRIVE
  FINANCING
  TRADE_IN
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  FOLLOW_UP
  CONVERTED
  LOST
}

// ───────────── Auth / RBAC ─────────────
model Role {
  id          String           @id @default(cuid())
  key         String           @unique // SUPER_ADMIN, ADMIN, SALES_MANAGER, SALES_REP, CONTENT_MANAGER
  name        String
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique // e.g. vehicles:write
  label String
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  isActive      Boolean        @default(true)
  roleId        String
  role          Role           @relation(fields: [roleId], references: [id])
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      RefreshSession[]
  resetTokens   PasswordResetToken[]
  assignedLeads Lead[]         @relation("LeadAssignee")
  leadNotes     LeadNote[]
  followUps     LeadFollowUp[]
  notifications Notification[]
  auditLogs     AuditLog[]
  blogPosts     BlogPost[]

  @@index([roleId])
}

model RefreshSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────── Inventory ─────────────
model Make {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  models    Model[]
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Model {
  id        String    @id @default(cuid())
  name      String
  slug      String
  makeId    String
  make      Make      @relation(fields: [makeId], references: [id], onDelete: Cascade)
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([makeId, slug])
}

model VehicleCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  vehicles    Vehicle[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Vehicle {
  id             String           @id @default(cuid())
  slug           String           @unique
  stockNumber    String           @unique
  vin            String?          @unique
  title          String
  makeId         String
  modelId        String
  categoryId     String?
  year           Int
  trim           String?
  price          Decimal          @db.Decimal(12, 2)
  salePrice      Decimal?         @db.Decimal(12, 2)
  mileage        Int              @default(0)
  condition      VehicleCondition @default(USED)
  bodyType       String?
  fuelType       String?
  transmission   String?
  drivetrain     String?
  engine         String?
  cylinders      Int?
  horsepower     Int?
  exteriorColor  String?
  interiorColor  String?
  doors          Int?
  seats          Int?
  description    String?
  history        String? // vehicle history notes
  status         VehicleStatus    @default(AVAILABLE)
  publishStatus  PublishStatus    @default(DRAFT)
  isFeatured     Boolean          @default(false)
  arrivedAt      DateTime         @default(now())
  soldAt         DateTime?
  make           Make             @relation(fields: [makeId], references: [id])
  model          Model            @relation(fields: [modelId], references: [id])
  category       VehicleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images         VehicleImage[]
  features       VehicleFeature[]
  leads          Lead[]
  testDrives     TestDriveRequest[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([makeId, modelId])
  @@index([year])
  @@index([price])
  @@index([mileage])
  @@index([status, publishStatus])
  @@index([isFeatured])
  @@index([bodyType])
  @@index([categoryId])
}

model VehicleImage {
  id        String   @id @default(cuid())
  vehicleId String
  url       String
  publicId  String? // Cloudinary public id or local filename
  alt       String?
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([vehicleId, position])
}

model VehicleFeature {
  id        String  @id @default(cuid())
  vehicleId String
  name      String
  category  String? // e.g. Safety, Comfort, Technology
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, name])
}

// ───────────── Customers & Leads ─────────────
model Customer {
  id               String              @id @default(cuid())
  email            String              @unique
  firstName        String
  lastName         String
  phone            String?
  city             String?
  province         String?
  notes            String?
  leads            Lead[]
  testDrives       TestDriveRequest[]
  financing        FinancingApplication[]
  tradeIns         TradeInRequest[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model Lead {
  id          String      @id @default(cuid())
  type        LeadType
  status      LeadStatus  @default(NEW)
  customerId  String
  vehicleId   String?
  assigneeId  String?
  subject     String?
  message     String?
  source      String?     @default("website")
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle     Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  assignee    User?       @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  notes       LeadNote[]
  followUps   LeadFollowUp[]
  testDrive   TestDriveRequest?
  financing   FinancingApplication?
  tradeIn     TradeInRequest?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@index([type])
  @@index([assigneeId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([createdAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  authorId  String?
  body      String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([leadId])
}

model LeadFollowUp {
  id          String    @id @default(cuid())
  leadId      String
  userId      String?
  dueAt       DateTime
  note        String?
  completedAt DateTime?
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([leadId])
  @@index([dueAt])
}

model TestDriveRequest {
  id            String    @id @default(cuid())
  leadId        String    @unique
  customerId    String
  vehicleId     String?
  preferredDate DateTime
  preferredTime String?
  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle       Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
}

model FinancingApplication {
  id             String   @id @default(cuid())
  leadId         String   @unique
  customerId     String
  vehicleId      String?
  employmentStatus String?
  employer       String?
  annualIncome   Decimal? @db.Decimal(12, 2)
  monthlyHousing Decimal? @db.Decimal(12, 2)
  downPayment    Decimal? @db.Decimal(12, 2)
  termMonths     Int?
  creditRating   String?
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

model TradeInRequest {
  id          String   @id @default(cuid())
  leadId      String   @unique
  customerId  String
  make        String
  model       String
  year        Int
  mileage     Int
  vin         String?
  condition   String?
  details     String?
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

// ───────────── CMS ─────────────
model WebsitePage {
  id              String        @id @default(cuid())
  slug            String        @unique // "home" for homepage
  title           String
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  isSystem        Boolean       @default(false) // system pages cannot be deleted
  status          PublishStatus @default(DRAFT)
  publishedAt     DateTime?
  sections        PageSection[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model PageSection {
  id        String      @id @default(cuid())
  pageId    String
  type      String // registry key: hero, featured-vehicles, rich-text, ...
  position  Int         @default(0)
  isVisible Boolean     @default(true)
  content   Json        @default("{}")
  page      WebsitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([pageId, position])
}

model NavigationMenu {
  id        String           @id @default(cuid())
  key       String           @unique // header, footer
  name      String
  items     NavigationItem[]
  updatedAt DateTime         @updatedAt
}

model NavigationItem {
  id        String          @id @default(cuid())
  menuId    String
  parentId  String?
  label     String
  url       String
  position  Int             @default(0)
  isVisible Boolean         @default(true)
  openInNewTab Boolean      @default(false)
  menu      NavigationMenu  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent    NavigationItem? @relation("NavTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  NavigationItem[] @relation("NavTree")

  @@index([menuId, position])
}

model Testimonial {
  id        String        @id @default(cuid())
  author    String
  role      String?
  body      String
  rating    Int           @default(5)
  position  Int           @default(0)
  status    PublishStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model FAQ {
  id        String        @id @default(cuid())
  question  String
  answer    String
  category  String?
  position  Int           @default(0)
  status    PublishStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Service {
  id          String        @id @default(cuid())
  title       String
  description String
  icon        String?
  imageUrl    String?
  position    Int           @default(0)
  status      PublishStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Banner {
  id        String        @id @default(cuid())
  title     String
  body      String?
  imageUrl  String?
  ctaLabel  String?
  ctaUrl    String?
  placement String        @default("top")
  position  Int           @default(0)
  status    PublishStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model BlogPost {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String?
  body        String
  coverUrl    String?
  authorId    String?
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  author      User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String
  publicId  String?
  filename  String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
}

// ───────────── Settings / System ─────────────
model WebsiteSetting {
  key       String   @id // e.g. general, contact, seo, social, hours, email
  value     Json
  updatedAt DateTime @updatedAt
}

model ThemeSetting {
  id             String   @id @default("default")
  primaryColor   String   @default("#0f172a")
  secondaryColor String   @default("#1e293b")
  accentColor    String   @default("#c8a45c")
  headingFont    String   @default("Playfair Display")
  bodyFont       String   @default("Inter")
  logoUrl        String?
  faviconUrl     String?
  buttonRadius   String   @default("0.25rem")
  layoutWidth    String   @default("1280px")
  updatedAt      DateTime @updatedAt
}

model Notification {
  id        String    @id @default(cuid())
  userId    String?
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // create, update, delete, login...
  entity     String
  entityId   String?
  metadata   Json?
  ip         String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
